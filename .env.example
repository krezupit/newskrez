# Database Configuration (Hostinger hPanel MySQL details)
DATABASE_URL="mysql://u123456789_news:YourStrongPassword@localhost:3306/u123456789_newskrez"
DB_HOST="localhost"
DB_PORT=3306
DB_USER="u123456789_news"
DB_PASSWORD="YourStrongPassword"
DB_NAME="u123456789_newskrez"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="https://newskrez.com"
NEXT_PUBLIC_SITE_NAME="NewsKrez"
NEXT_PUBLIC_SITE_TAGLINE="Global News. Healthcare. Technology. Regulatory Intelligence."

# Security & Authentication
AUTH_SECRET="generate-a-random-64-character-hex-string-for-production"
NEXTAUTH_SECRET="generate-a-random-64-character-hex-string-for-production"
NEXTAUTH_URL="https://newskrez.com"

# Ingestion Cron Security Secret (for triggering /api/cron/fetch safely)
CRON_SECRET="generate-a-secret-token-for-cron-http-calls"

# OpenFDA API (Optional key for higher rate limits: https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=""

# Admin Default Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@newskrez.com"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction123!"

# News API Providers
GNEWS_API_KEY="your-gnews-api-key"
NEWSAPI_API_KEY="your-newsapi-api-key"
CURRENTS_API_KEY="your-currents-api-key"
MEDIASTACK_API_KEY="your-mediastack-api-key"
